# Development defaults for the Base44 sandbox.
#
# This file is listed FIRST in the compose `env_file` chain, so every value here
# is a placeholder that the platform-managed file (/run/base44/app.env, listed
# LAST) overrides. Nothing secret belongs in this file.

# Session signing key. The Base44 sandbox injects a generated value through
# /run/base44/app.env; leave this blank so the platform value always wins.
SESSION_SECRET=

# Outbound email. With no SMTP host the notification service records every
# message as UNSENT and writes it to the outbox directory instead of pretending
# delivery succeeded. Set these to send real mail (or provide them as secrets).
NOTIFICATION_TRANSPORT=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=recognition@casidra.co.za
SMTP_USE_TLS=1
SMTP_TIMEOUT=10

# Password given to every seeded development account.
SEED_DEFAULT_PASSWORD=Casidra#2026
